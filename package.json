{
  "name": "karachi-cinematic",
  "version": "1.0.0",
  "description": "Production-quality cinematic scroll website for Karachi, Pakistan",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "test": "node --test tests/**/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:security": "node --test tests/security.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:smoke": "node --test tests/smoke.test.js",
    "audit": "npm audit",
    "lint:legacy": "grep -ri 'mostar\\|bosnia\\|neretva\\|stari most\\|kujundziluk\\|kajtaz' . --include='*.js' --include='*.html' --include='*.css' --include='*.json' --exclude-dir=node_modules || echo 'No legacy references found'"
  },
  "keywords": [
    "karachi",
    "pakistan",
    "cinematic",
    "landmarks",
    "travel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "argon2": "^0.31.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "rotating-file-stream": "^3.1.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "prisma": "^5.13.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
